# Vite reads this file from the frontend folder.
# Only VITE_* values are exposed to the browser. Never put JWT, MongoDB, SMTP, VAPID private keys, or storage secrets here.
#
# Development:
VITE_API_URL=http://localhost:4000
#
# Production build (set before `npm run build -w frontend`):
# VITE_API_URL=https://TODO-CONFIGURE-API-HOST
#
# PWA: no extra VITE_ variables. The service worker registers in production builds only
# and never caches /api/ responses. Optional browser push uses backend VAPID_* keys.

