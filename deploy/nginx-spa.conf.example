# SPA fallback for React Router (history mode).
# server_name and TLS paths: TODO: CONFIGURE
# Do not invent production hostnames here.

server {
    listen 80;
    listen [::]:80;
    server_name TODO_CONFIGURE_FRONTEND_HOST;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
