# =============================================================================
# SV Yuva Suraksha Yojana — environment template
# Copy to .env (repo root) and frontend/.env for Vite. NEVER commit real secrets.
#
# Environments: development | test | production
# Production MUST use a separate .env (or hoster secret store), not this file.
# =============================================================================

# --- Frontend (copy VITE_* into frontend/.env BEFORE `npm run build`) ---
# Production: https API URL only. VITE_* is visible in the browser bundle.
VITE_API_URL=http://localhost:4000

# --- Backend ---
NODE_ENV=development
PORT=4000

# Approved browser origins (CORS). Production: https:// hosts only. Never *.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# MongoDB Atlas — database name must be SVYSY. Do not use localhost in production.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/SVYSY?retryWrites=true&w=majority&appName=SVYSY
MONGODB_DB_NAME=SVYSY

# JWT — long random secrets, unique per environment. Prefer JWT_ACCESS_SECRET.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-32-plus
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Production: COOKIE_SAMESITE=strict (or none only if the API and SPA are on different sites over HTTPS)
COOKIE_SAMESITE=none

# Email — PRODUCTION CONFIGURATION REQUIRED. No mailer is implemented until a provider is chosen.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Aliases accepted by the API (same meaning as SMTP_*):
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_PROVIDER=none
EMAIL_ENABLED=false
SMTP_PASSWORD=

# --- Phase 13 analytics / jobs (not official scheme deadlines) ---
NOTIFICATION_POLL_SECONDS=60
JOB_TICK_MS=60000
JOBS_ENABLED=true
REMINDER_PENDING_REGISTRATION_DAYS=3
REMINDER_PENDING_DOCUMENT_DAYS=7
REMINDER_PAYMENT_DAYS=7
REMINDER_REVIEW_DAYS=7
DASHBOARD_CACHE_SECONDS=30
# Placeholders only — the API uses MONGODB_URI, not DATABASE_URL:
# DATABASE_URL=
# BACKEND_URL=http://localhost:4000


# Development admin seed only. Must remain false in production.
ALLOW_ADMIN_SEED=false
SEED_ADMIN_EMAIL=replace-admin-email@example.in
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_NAME=Portal Administrator

# Legacy aliases (optional)
JWT_SECRET=
JWT_EXPIRES_IN=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Excel import ---
MAX_EXCEL_FILE_SIZE_MB=5
MAX_EXCEL_ROWS=2000
MAX_EXCEL_PARSE_MS=60000
MAX_EXPORT_ROWS=5000

# --- Object storage (S3-compatible). Required when document APIs go live. ---
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# --- Phase 8/10 migration (never put real secrets here) ---
LEGACY_DATABASE_URL=
LEGACY_API_URL=
LEGACY_API_TOKEN=
LEGACY_API_AUTHORIZED=false
LEGACY_EXPORT_DIR=
LEGACY_SYSTEM_NAME=svyuvasuraksha-legacy
MONGODB_URI_MIGRATION_STAGING=
MONGODB_URI_PRODUCTION=
STORAGE_SOURCE=
STORAGE_DESTINATION=
DRY_RUN=true
MIGRATION_BATCH_SIZE=500
MIGRATION_SAMPLE_SIZE=25
MIGRATION_ADMIN_EMAIL=
MIGRATION_ADMIN_PASSWORD=
MIGRATION_ALLOW_APP_DB=false

# --- Phase 11 operations ---
# APP_VERSION overrides root package.json when set. Leave empty to use package.json.
APP_VERSION=
MAINTENANCE_MODE=false
MAINTENANCE_ALLOW_ADMIN=false
INACTIVE_ACCOUNT_DAYS=90
FEATURE_INSURANCE_HTTP=false
FEATURE_DOCUMENT_HTTP=false
FEATURE_PAYMENT_HTTP=false
FEATURE_REVIEW_HTTP=false
FEATURE_ECARD_HTTP=false
BACKUP_VERIFY_DIR=
SLOW_QUERY_MS=500
# Destructive maintenance is never the default. Scripts ignore this unless a future job documents it.
CONFIRM_DESTRUCTIVE_OPERATION=false

# --- Phase 12 AI (never put real keys here; never use VITE_ for AI_API_KEY) ---
# none|local = extractive RAG from the knowledge base (no external LLM). openai = optional Chat Completions.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_MAX_REQUESTS_PER_MINUTE=20
AI_MAX_DOCUMENT_SIZE_MB=8
AI_TIMEOUT_MS=20000
AI_MAX_PROMPT_CHARS=12000
AI_OCR_ENGINE=none

# --- Phase 14 PWA / optional browser push (never put real VAPID keys here) ---
# Leave empty to keep in-app (and email, if configured) notifications only.
# Browser push is never required. Do not force permission prompts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

